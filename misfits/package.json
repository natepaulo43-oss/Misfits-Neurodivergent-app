{
  "name": "misfits",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "debug-env": "node -e \"Object.keys(process.env).filter(k => k.startsWith('EXPO_PUBLIC_')).forEach(k => console.log(k + '=' + (process.env[k] ? 'SET' : 'MISSING')))\"",
    "vercel-build": "npm run debug-env && node node_modules/@expo/cli/build/bin/cli export -p web"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-firebase/app": "^23.8.6",
    "@react-native-firebase/app-check": "^23.8.6",
    "expo": "^54.0.0",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.10.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "private": true
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // Helper Functions
    // ============================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function hasValidAppCheck() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != null;
    }
    
    function getSignedInUserData() {
      return isSignedIn()
        ? (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
              ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
              : null
          )
        : null;
    }

    function getUserRole() {
      let userData = getSignedInUserData();
      return userData == null ? null : userData.role;
    }
    
    function isAdmin() {
      return isSignedIn() && getUserRole() in ['admin', 'super_admin'];
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAccountActive() {
      let userData = getSignedInUserData();
      // Default to true (active) if no user doc yet or field doesn't exist
      return userData == null || userData.accountSuspended != true;
    }
    
    function canMessage() {
      let userData = getSignedInUserData();
      // Default to true (can message) if no user doc yet or fields don't exist
      return (
        userData == null ||
        (userData.messagingDisabled != true && userData.accountSuspended != true)
      );
    }

    function canManageMentorAvailability(mentorId) {
      return isSignedIn() &&
        isOwner(mentorId);
    }
    
    // ============================================
    // Users Collection
    // ============================================
    
    match /users/{userId} {
      // Users can read their own full document; admins can read all user documents
      allow get: if isOwner(userId) || isAdmin();
      
      // Any signed-in user can read mentor-role documents (for discovery and session booking)
      // Student/admin-role documents are NOT readable by other users
      allow get: if isSignedIn() && resource.data.role == 'mentor';
      
      // List queries: only mentor-role documents are visible to other users.
      // Student documents (which contain neurodivergence, age, challengesText, etc.)
      // must never be returned by an arbitrary collection query from non-admins.
      // Firestore evaluates resource.data.role per-document at query time, so a
      // query with where('role','==','mentor') will pass; a bare getDocs() will not.
      allow list: if isSignedIn() && (resource.data.role == 'mentor' || isAdmin());
      
      // Users can create their own document (initial signup/onboarding).
      // ageVerifiedAt must be a server-generated timestamp written by the normal
      // signup path — reject any direct write that omits it, which would indicate
      // the client-side age check was bypassed.
      allow create: if isOwner(userId) &&
        request.resource.data.ageVerifiedAt is timestamp;
      
      // Users can update their own document when their account is active.
      // Admin-controlled fields (suspension, messaging, matching flags) are
      // immutable by the owner — only admins can change them via allow write above.
      // NOTE: use resource.data directly (not isAccountActive()) here because
      // isAccountActive() calls get() on the same document being updated, which
      // is a circular read that may not resolve correctly in Firestore rules.
      allow update: if isOwner(userId) &&
        resource.data.get('accountSuspended', false) != true &&
        !(request.resource.data.role in ['admin', 'super_admin']) &&
        request.resource.data.get('accountSuspended', false) == resource.data.get('accountSuspended', false) &&
        request.resource.data.get('suspensionReason', '') == resource.data.get('suspensionReason', '') &&
        request.resource.data.get('messagingDisabled', false) == resource.data.get('messagingDisabled', false) &&
        request.resource.data.get('mentorMatchingDisabled', false) == resource.data.get('mentorMatchingDisabled', false);
      
      // Admins can write any user document
      allow write: if isAdmin();

      // Backup codes subcollection — hashes must never be exposed to any client.
      // All reads and writes go through Cloud Functions (admin SDK bypasses these rules).
      match /backupCodes/{codeId} {
        allow read, write: if false;
      }
    }
    
    // ============================================
    // Message Threads Collection
    // ============================================
    
    match /threads/{threadId} {
      // Participants can read their threads
      allow get: if isSignedIn() && 
        request.auth.uid in resource.data.participantIds;
      
      // List queries are restricted to threads the requesting user participates in.
      // The client MUST include where('participantIds','array-contains', uid) so
      // Firestore can evaluate resource.data.participantIds at query time.
      allow list: if isSignedIn() &&
        request.auth.uid in resource.data.participantIds;

      // Messaging-enabled users can create threads they are part of.
      // Neither participant may have blocked the other.
      allow create: if isSignedIn() &&
        canMessage() &&
        request.auth.uid in request.resource.data.participantIds &&
        !exists(/databases/$(database)/documents/blocks/$(request.resource.data.participantIds[0] + "_" + request.resource.data.participantIds[1])) &&
        !exists(/databases/$(database)/documents/blocks/$(request.resource.data.participantIds[1] + "_" + request.resource.data.participantIds[0]));

      // Participants with messaging enabled can update thread metadata
      allow update: if isSignedIn() &&
        canMessage() &&
        request.auth.uid in resource.data.participantIds;
      
      // Admins can read all threads (for moderation)
      allow read: if isAdmin();
      
      // Admins cannot delete threads (preserve audit trail)
      allow delete: if false;
      
      // ============================================
      // Messages Subcollection
      // ============================================
      
      match /messages/{messageId} {
        // Participants can read messages in their threads
        allow read: if isSignedIn() && 
          request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participantIds;
        
        // Participants with messaging enabled can create messages in their threads.
        // Block checks prevent either party from sending if a block exists.
        allow create: if isSignedIn() &&
          canMessage() &&
          request.auth.uid in get(/databases/$(database)/documents/threads/$(threadId)).data.participantIds &&
          request.auth.uid == request.resource.data.fromUserId &&
          !exists(/databases/$(database)/documents/blocks/$(request.resource.data.fromUserId + "_" + request.resource.data.toUserId)) &&
          !exists(/databases/$(database)/documents/blocks/$(request.resource.data.toUserId + "_" + request.resource.data.fromUserId));
        
        // Admins can read all messages (for moderation)
        allow read: if isAdmin();
        
        // Admins can update messages (for flagging/review)
        allow update: if isAdmin();
        
        // Messages cannot be deleted (preserve audit trail)
        allow delete: if false;
      }
    }
    
    // ============================================
    // Curated Content Collection
    // ============================================
    
    match /curatedContent/{contentId} {
      // Everyone can read published content
      allow read: if resource.data.status == 'published';
      
      // Admins can read all content (including drafts)
      allow read: if isAdmin();
      
      // Admins can create, update, and delete content
      allow create, update, delete: if isAdmin();
    }
    
    // ============================================
    // Matches Collection
    // ============================================
    
    match /matches/{matchId} {
      // Students and mentors can read their own matches
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.mentorId
      );
      
      // Admins can read all matches
      allow read: if isAdmin();
      
      // Admins can create, update, and delete matches
      allow create, update, delete: if isAdmin();
    }
    
    // ============================================
    // Mentor Availability Collection
    // ============================================
    
    match /mentorAvailability/{mentorId} {
      // Anyone can read mentor availability (for booking)
      allow read: if isSignedIn();
      
      // Mentors can create/update their own availability
      allow create, update: if canManageMentorAvailability(mentorId);
      
      // Admins can read/write all availability
      allow read, write: if isAdmin();
      
      // No one can delete availability (preserve data)
      allow delete: if false;
    }
    
    // ============================================
    // Sessions Collection
    // ============================================
    
    match /sessions/{sessionId} {
      // Students and mentors can read their own sessions
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.studentId ||
        request.auth.uid == resource.data.mentorId
      );
      
      // Students can create session requests (where they are the student)
      allow create: if isSignedIn() && 
        isAccountActive() &&
        request.auth.uid == request.resource.data.studentId &&
        getUserRole() == 'student';
      
      // Students can update limited fields on their sessions
      // (accept reschedule, cancel)
      allow update: if isSignedIn() && 
        isAccountActive() &&
        request.auth.uid == resource.data.studentId &&
        (
          // Can only update status to cancelled or confirmed (from reschedule_proposed)
          (request.resource.data.status == 'cancelled') ||
          (resource.data.status == 'reschedule_proposed' && 
           request.resource.data.status == 'confirmed')
        );
      
      // Mentors can update their sessions
      // (accept, decline, propose reschedule, mark complete, cancel)
      allow update: if isSignedIn() && 
        isAccountActive() &&
        request.auth.uid == resource.data.mentorId &&
        getUserRole() == 'mentor';
      
      // Admins can read all sessions
      allow read: if isAdmin();
      
      // Admins can create, update, and delete sessions
      allow create, update, delete: if isAdmin();
    }
    
    // ============================================
    // Session Notes Collection (Mentor Private)
    // ============================================
    
    match /sessionNotes/{noteId} {
      // Only the mentor who created the note can read it
      allow read: if isSignedIn() && 
        request.auth.uid == resource.data.mentorId;
      
      // Mentors can create notes for their sessions
      allow create: if isSignedIn() && 
        isAccountActive() &&
        request.auth.uid == request.resource.data.mentorId &&
        getUserRole() == 'mentor';
      
      // Mentors can update their own notes
      allow update: if isSignedIn() && 
        isAccountActive() &&
        request.auth.uid == resource.data.mentorId;
      
      // Admins can read all notes (for oversight)
      allow read: if isAdmin();
      
      // Admins can create/update notes
      allow create, update: if isAdmin();
      
      // No one can delete notes (preserve audit trail)
      allow delete: if false;
    }
    
    // ============================================
    // Books Collection (Future - Currently Mock Data)
    // ============================================
    
    match /books/{bookId} {
      // Everyone can read approved books
      allow read: if resource.data.approved == true;
      
      // Admins can read all books
      allow read: if isAdmin();
      
      // Admins can create, update, and delete books
      allow create, update, delete: if isAdmin();
    }
    
    // ============================================
    // Book Purchases Collection (Future)
    // ============================================
    
    match /purchases/{purchaseId} {
      // Users can read their own purchases
      allow read: if isOwner(resource.data.userId);
      
      // Users can create their own purchases
      allow create: if isOwner(request.resource.data.userId) && isAccountActive();
      
      // Admins can read all purchases
      allow read: if isAdmin();
    }

    // ============================================
    // Message Reports Collection
    // ============================================

    match /reports/{reportId} {
      // Users can submit reports for messages in threads they participate in
      allow create: if isSignedIn() &&
        isAccountActive() &&
        request.auth.uid == request.resource.data.reportedById;

      // Users can read their own submitted reports
      allow get: if isSignedIn() &&
        request.auth.uid == resource.data.reportedById;

      // Admins can read and update all reports (triage, resolve)
      allow read, update: if isAdmin();

      // Reports are never deleted (audit trail)
      allow delete: if false;
    }

    // ============================================
    // Blocks Collection
    // Document ID convention: {fromUserId}_{toUserId}
    // ============================================

    match /blocks/{blockId} {
      // The blocking user can create and revoke their own blocks
      allow create: if isSignedIn() &&
        isAccountActive() &&
        request.auth.uid == request.resource.data.fromUserId;

      allow delete: if isSignedIn() &&
        request.auth.uid == resource.data.fromUserId;

      // Both parties can read a block document (to know they're blocked).
      // resource is null when the document doesn't exist; allow that case so
      // getDoc returns an empty snapshot instead of permission-denied, which
      // is what isEitherBlocked() relies on to confirm no block exists.
      allow read: if isSignedIn() && (
        resource == null ||
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );

      allow read, write: if isAdmin();

      // Blocks are soft-deleted (delete op above); document level delete is fine
    }
  }
}
